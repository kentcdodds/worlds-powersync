{
	"name": "worlds-cloudflare",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "A shared 3D voxel world that people and their AI agents build together, synced live with PowerSync.",
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"esbuild": "^0.25.12",
		"typescript": "^5.9.0",
		"@powersync/common": "2.3.1",
		"@powersync/react": "2.0.2",
		"@powersync/shared-internals": "1.3.1",
		"@powersync/web": "2.4.2",
		"@react-three/fiber": "9.8.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"three": "0.186.1",
		"wrangler": "^4"
	},
	"scripts": {
		"build:client": "esbuild app/client/main.tsx --bundle --minify --format=esm --target=es2022 --outfile=public/client/main.js --define:process.env.NODE_ENV='\"production\"'",
		"deploy": "npm run build:client && wrangler deploy"
	}
}