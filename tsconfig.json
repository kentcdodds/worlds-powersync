{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["app", "src"]
}
